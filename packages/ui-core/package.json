{
  "name": "@wystack/ui-core",
  "version": "0.2.0",
  "type": "module",
  "main": "src/index.ts",
  "exports": {
    ".": "./src/index.ts",
    "./theme": "./src/theme/index.ts",
    "./styles": "./src/styles/tokens.css",
    "./tokens": "./src/tokens/schema.ts"
  },
  "scripts": {
    "typecheck": "tsc --noEmit",
    "lint": "oxlint src/ scripts/",
    "test": "bun run check:tokens && vitest run --passWithNoTests",
    "build:tokens": "bun scripts/build-tokens.ts",
    "check:tokens": "bun scripts/build-tokens.ts --check"
  },
  "dependencies": {
    "zustand": "^5.0.0"
  },
  "devDependencies": {
    "@types/bun": "^1.4.2",
    "typescript": "~5.7.2",
    "vitest": "^3.0.0"
  },
  "peerDependencies": {
    "tailwindcss": ">=4.0.0"
  }
}
